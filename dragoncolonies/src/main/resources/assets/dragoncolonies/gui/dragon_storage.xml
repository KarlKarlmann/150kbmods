<window size="420 260" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/1.20.1/src/main/resources/assets/blockui/gui/block_ui.xsd">
<!-- Haupt-Hintergrund -->
<image pos="0 0" size="420 260" source="minecolonies:textures/gui/builderhut/builder_paper_wide2.png"/>

<!-- Header-Bereich -->
<text id="title_text" pos="20 12" size="230 14" color="#281808" label="$(dragoncolonies.gui.dragon_storage.title)" textscale="1.2"/>

<button id="btn_request_pointer" pos="260 10" size="140 18" textcolor="#000000"
        source="minecolonies:textures/gui/builderhut/builder_button_quite_small.png"
        label="$(dragoncolonies.gui.dragon_storage.request_pointer)" textscale="0.85"/>

<!-- LINKES PANEL: Drachenliste -->
<text pos="20 30" size="190 10" color="#4A3B32" label="$(dragoncolonies.gui.dragon_storage.registered_dragons)" textscale="0.85"/>

<list id="list_stored" pos="15 42" size="195 205">
    <box size="100% 32" linewidth="0">
        <button id="action_btn" pos="0 1" size="190 30"
                source="minecolonies:textures/gui/builderhut/builder_button_quite_small.png" label=""/>
        <text id="row_name" pos="6 2" size="130 10" color="#1A0F00" label="" textscale="0.85"/>
        <!-- Subline mit Priorität: Hunger -> HP -> Spezies -->
        <text id="row_sub" pos="6 14" size="180 14" color="#554433" label="" textscale="0.72"/>
        <text id="row_rank" pos="145 4" size="40 12" color="#8B0000" label="" textscale="0.9" textalign="MIDDLE"/>
    </box>
</list>

<!-- RECHTES PANEL: Detail-Inspector -->
<view id="detail_container" pos="218 32" size="188 220">
    
<!-- Pergament-Overlay als Rahmen für Modell und Daten (Höhe 176px) -->
<image pos="0 0" size="188 176" source="bookofdragons:textures/gui/book/overlaydiettext.png"/>

<!-- Rolle / Zuweisung oben rechts (X=92) mit freiem Fallraum nach unten -->
<dropdown id="dropdown_assignment" pos="92 6" size="90 16" maxContentHeight="95" dropDownSize="90 95" textcolor="#000000"
          source="minecolonies:textures/gui/builderhut/builder_button_quite_small.png"
          label="$(dragoncolonies.gui.dragon_storage.mode.label)" textscale="0.75" enabled="false">
    <button id="button" pos="0 0" size="100% 14"
            source="minecolonies:textures/gui/builderhut/builder_button_quite_small.png"
            label="" textscale="0.75" textcolor="#000000"/>
</dropdown>

<!-- Header-Info unterhalb des Modells (Zeile um 4px nach unten gerückt) -->
<text id="detail_name" pos="6 58" size="115 11" color="#1A0F00" label="$(dragoncolonies.gui.dragon_storage.select_dragon)" textscale="0.95"/>
<text id="detail_status_badge" pos="122 58" size="60 11" color="#0B5313" label="$(dragoncolonies.gui.dragon_storage.status_placeholder)" textscale="0.8" textalign="MIDDLE"/>

<text id="detail_species" pos="6 70" size="88 9" color="#3B220C" label="$(dragoncolonies.gui.dragon_storage.species_placeholder)" textscale="0.75"/>
<text id="detail_stage" pos="95 70" size="88 9" color="#4A3B32" label="$(dragoncolonies.gui.dragon_storage.stage_placeholder)" textscale="0.75"/>

<!-- Vital-Block mit kontrastreichen Farben auf hellbraunem Grund -->
<text pos="6 82" size="40 9" color="#4A3B32" label="$(dragoncolonies.gui.dragon_storage.hunger)" textscale="0.75"/>
<text id="detail_hunger" pos="48 82" size="130 9" color="#8A2E00" label="0%" textscale="0.75"/>

<text pos="6 93" size="40 9" color="#4A3B32" label="$(dragoncolonies.gui.dragon_storage.hp)" textscale="0.75"/>
<text id="detail_health" pos="48 93" size="130 9" color="#0B5313" label="0 / 0" textscale="0.75"/>

<text pos="6 104" size="40 9" color="#4A3B32" label="$(dragoncolonies.gui.dragon_storage.affection)" textscale="0.75"/>
<text id="detail_affection" pos="48 104" size="130 9" color="#6B1D5C" label="0 / 1000" textscale="0.75"/>

<!-- Attribut-Grid -->
<text pos="6 116" size="176 9" color="#3B220C" label="$(dragoncolonies.gui.dragon_storage.primary_attributes)" textscale="0.72" textalign="MIDDLE"/>
<text id="detail_stats_grid_1" pos="6 126" size="176 9" color="#1A0F00" label="CON: -  ATH: -  AGI: -" textscale="0.75"/>
<text id="detail_stats_grid_2" pos="6 136" size="176 9" color="#1A0F00" label="PRW: -  POT: -  VIG: -" textscale="0.75"/>

<!-- Ausrüstungs- & Nahrungs-Label -->
<text pos="6 148" size="85 9" color="#4A3B32" label="$(dragoncolonies.gui.dragon_storage.equipment)" textscale="0.7"/>
<text pos="95 148" size="85 9" color="#4A3B32" label="$(dragoncolonies.gui.dragon_storage.favorite_food)" textscale="0.7"/>

<!-- Aktions-Buttons nach unten versetzt (Y=178 und Y=196) -->
<button id="btn_retrieve" pos="0 178" size="92 16" textcolor="#000000"
        source="minecolonies:textures/gui/builderhut/builder_button_quite_small.png"
        label="$(dragoncolonies.gui.dragon_storage.btn_retrieve)" textscale="0.8" enabled="false" tooltip="$(dragoncolonies.gui.dragon_storage.btn_retrieve.tooltip)"/>

<button id="btn_emergency" pos="96 178" size="92 16" textcolor="#8B0000"
        source="minecolonies:textures/gui/builderhut/builder_button_quite_small.png"
        label="$(dragoncolonies.gui.dragon_storage.btn_emergency)" textscale="0.8" enabled="false" tooltip="$(dragoncolonies.gui.dragon_storage.btn_emergency.tooltip)"/>

<button id="btn_sell" pos="0 196" size="92 16" textcolor="#000000"
        source="minecolonies:textures/gui/builderhut/builder_button_quite_small.png"
        label="$(dragoncolonies.gui.dragon_storage.btn_export)" textscale="0.8" enabled="false" tooltip="$(dragoncolonies.gui.dragon_storage.btn_export.tooltip)"/>

<button id="btn_release" pos="96 196" size="92 16" textcolor="#FF2222"
        source="minecolonies:textures/gui/builderhut/builder_button_quite_small.png"
        label="$(dragoncolonies.gui.dragon_storage.btn_release)" textscale="0.8" enabled="false" tooltip="$(dragoncolonies.gui.dragon_storage.btn_release.tooltip)"/>

</view>
</window> 