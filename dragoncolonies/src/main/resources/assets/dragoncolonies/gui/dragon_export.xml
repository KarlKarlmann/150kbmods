<window size="420 260" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/1.20.1/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image pos="0 0" size="420 260" source="minecolonies:textures/gui/builderhut/builder_paper_wide2.png"/>

    <!-- TITEL: ID hinzugefügt & Breite auf 350 erhöht -->
    <text id="txt_title" pos="20 12" size="350 14" color="#281808" label="$(dragoncolonies.gui.dragon_export.title)" textscale="1.0"/>

    <button id="btn_close" pos="380 10" size="20 20" textcolor="#000000" source="minecolonies:textures/gui/builderhut/builder_button_quite_small.png" label="X" textscale="1.0"/>

    <!-- LINKE SEITE: Liste der Fraktionen -->
    <list id="list_offers" pos="15 42" size="130 205">
        <box size="100% 40" linewidth="0">
            <button id="btn_faction" pos="0 1" size="124 38" source="dragoncolonies:textures/gui/faction_button.png" label=""/>
            <image id="img_faction_frame" pos="4 4" size="32 32" source="dragoncolonies:textures/gui/slot.png"/>
            <image id="img_faction_icon" pos="12 12" size="16 16" source=""/>
            <text id="lbl_faction_name" pos="40 15" size="80 10" color="#1A0F00" label="" textscale="0.85"/>
        </box>
    </list>

    <!-- RECHTE SEITE: Details zum ausgewählten Angebot -->
    <view id="detail_container" pos="155 32" size="250 220">
        <image pos="0 0" size="250 170" source="bookofdragons:textures/gui/book/overlaydiettext.png"/>
        <image id="detail_faction_img" pos="10 10" size="48 48" source="minecolonies:textures/gui/modules/help.png"/>
        <text id="detail_faction_name" pos="65 15" size="160 14" color="#281808" label="$(dragoncolonies.gui.dragon_export.select_faction)" textscale="1.1"/>
        <text id="detail_flavor_text" pos="65 35" size="170 40" color="#4A3525" label="" textscale="0.8" wrap="true"/>
        
        <text pos="10 90" size="230 10" color="#63390B" label="$(dragoncolonies.gui.dragon_export.offered_tribute)" textscale="0.9" textalign="CENTER"/>
        
        <button id="btn_accept" pos="80 180" size="90 20" textcolor="#005500" source="minecolonies:textures/gui/builderhut/builder_button_quite_small.png" label="$(dragoncolonies.gui.dragon_export.accept_offer)" textscale="0.9" enabled="false"/>
    </view>
</window>